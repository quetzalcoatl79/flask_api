###############################################
# Global Ignore / Security & Convenience
###############################################
# NEVER commit real secret env files. Provide a sanitized template instead.
.env*
!.env.example
!.env.sample
!.env.template

*.pem
*.key
*.crt
*.der
*.pfx
*.p12

# Logs & runtime artifacts
*.log
*.log.*
*.pid
*.seed
*.pid.lock
*.tmp
*.cache
*.swp
*.swo
*.orig
*.bak
*.rej
*.prof

# OS / Editor noise
.DS_Store
Thumbs.db
ehthumbs.db
Icon?
desktop.ini
.Spotlight-V100
.Trashes
.fseventsd
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.code-workspace

###############################################
# Python / Flask / Celery Backend
###############################################
__pycache__/
*.py[cod]
*$py.class
*.pyo
.python-version

# Virtual environments
venv/
.venv/
env/
.env/  

# Build / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Tool caches
.mypy_cache/
.pytest_cache/
.coverage*
coverage.xml
.hypothesis/
.cache/
.pytype/
.pyre/

# Flask instance folder (contains secrets / uploads) - create if used
instance/

# SQLite / local DB
*.sqlite
*.sqlite3
db.sqlite*

# Celery artifacts
celerybeat-schedule*
celerybeat.pid
celery_worker.log

# Alembic: keep migration scripts (DO NOT ignore versions)
alembic.ini
!/backend/migrations/versions/*.py
!/backend/migrations/env.py

###############################################
# Node / Next.js Frontend
###############################################
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
!.yarn/sdks
!.yarn/versions
.pnpm-debug.log*

# Next.js build output
.next/
out/
build/
.turbo/

# Testing / coverage
coverage/
lcov.info

# SWC / Babel cache
.swc/
.babel-cache/

# ESLint / TypeScript artifacts
.eslintcache
*.tsbuildinfo
next-env.d.ts

# Vercel / deployment platform
.vercel

# Lock / integrity files (kept where needed)
package-lock.json
yarn.lock
pnpm-lock.yaml
*.pnpm.cjs

###############################################
# Docker / Compose
###############################################
docker-compose.override.yml
*.tar
.dockerignore~

###############################################
# Miscellaneous
###############################################
# Ignore uploaded user files if any folder used (uncomment & adapt)
# uploads/
# media/

# Local scripts or experimental notebooks
notebooks/.ipynb_checkpoints/
*.ipynb_checkpoints
*.ipynb~

# Temporary export / reports
reports/
tmp/
temp/

# Prevent committing security scan outputs / tool reports
bandit.json
benchmark-results.json

# Ensure we DO keep essential dependency & config files
!requirements.txt
!backend/requirements.txt
!package.json
!frontend/package.json

# If you add sample env for backend/frontend, whitelist explicitly
!backend/.env.example
!frontend/.env.example

###############################################
# End of .gitignore
###############################################
